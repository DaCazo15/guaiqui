{
  "name": "guaiqui",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @guaiqui/web dev",
    "dev:admin": "pnpm --filter @guaiqui/admin dev",
    "build": "pnpm -r run --if-present build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/shared/src/types/database.ts",
    "db:reset": "supabase db reset",
    "security:scan-bundle": "node scripts/scan-bundle-leaks.mjs",
    "typecheck": "pnpm -r run --if-present typecheck"
  },

  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.29.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
